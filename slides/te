!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>A Nossa Atmosfera</title><style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#020617;color:#fff;font-family:Arial,sans-serif}.slide{position:absolute;inset:0;display:none;padding:5vh 5vw 9vh;overflow:hidden;background:#07111d}.slide.active{display:block}.bg{position:absolute;inset:-6%;background-size:cover;background-position:center;animation:kb 16s ease-in-out infinite alternate;transition:transform 1.1s ease}@keyframes kb{to{transform:scale(1.14) translate(-2%,-1%)}}.shade{position:absolute;inset:0;background:linear-gradient(90deg,#020617f5,#020617c9 50%,#02061755)}header,h2,p,.content,.q{position:relative;z-index:2}header{display:flex;justify-content:space-between;border-bottom:1px solid #ffffff30;padding-bottom:1vh;font-size:clamp(11px,.9vw,17px);letter-spacing:2px;color:#ffffffaa}h2{font-size:clamp(42px,4.4vw,84px);line-height:1.02;margin:5vh 0 2vh;font-weight:900}.lead{font-size:clamp(20px,1.5vw,30px);line-height:1.45;max-width:950px}.content{display:flex;gap:1.2vw;align-items:stretch;margin-top:6vh;flex-wrap:wrap}.card{flex:1 1 16%;background:#07111de8;border:1px solid #ffffff35;border-radius:24px;padding:2.3vh 1.6vw;min-height:23vh;box-shadow:0 18px 40px #0008}.card strong{display:block;font-size:clamp(24px,1.8vw,36px);margin-bottom:1.5vh}.card p{font-size:clamp(17px,1.15vw,23px);line-height:1.4}.huge{font-size:clamp(62px,7vw,135px)!important}.arrow{flex:0 0 auto;font-size:3vw;align-self:center}.q{display:inline-block;margin-top:4vh;background:#b9e1ff;color:#08213c;padding:1.3vh 1.6vw;border-radius:999px;font-size:clamp(18px,1.25vw,25px);font-weight:800}.reveal{opacity:0;transform:translateY(18px) scale(.98);transition:.45s ease}.reveal.shown{opacity:1;transform:none}.zoom .bg{transform:scale(1.30) translate(-5%,-3%)}nav{position:fixed;z-index:20;right:2vw;bottom:2vh;background:#020617cc;border:1px solid #ffffff22;border-radius:999px;padding:7px;display:flex;align-items:center;gap:8px}button{width:44px;height:44px;border:0;border-radius:50%;background:#ffffff12;color:#fff;font-size:22px}#count{min-width:70px;text-align:center;font-size:12px}</style></head><body><main id='deck'></main><nav><button id='prev'>←</button><span id='count'></span><button id='next'>→</button><button id='full'>⛶</button></nav><script>const DATA=[{"title": "O ar é uma coisa só?", "lead": "O ar que nos cerca é uma <b>mistura de diferentes gases.</b>", "cards": ["☁ Quais gases estamos respirando agora?", "🌿 Sustenta a vida", "≋ Regula o clima", "🛡 Nos protege"], "bg": "https://images.unsplash.com/photo-1614728894747-a83421e2b9c9?q=85&w=2400&auto=format&fit=crop"}, {"title": "Composição do ar", "lead": "Se o ar é uma mistura, <b>quanto há de cada gás?</b>", "cards": ["<span class='huge'>78%</span><b>N₂ — Nitrogênio</b>", "<span class='huge'>21%</span><b>O₂ — Oxigênio</b>", "<span class='huge'>≈1%</span><b>Outros gases</b><p>Argônio, CO₂, vapor d’água…</p>"], "bg": "https://images.unsplash.com/photo-1534088568595-a066f410bcda?q=85&w=2400&auto=format&fit=crop"}, {"title": "Nitrogênio: está no ar, mas como chega à planta?", "lead": "A planta precisa do nitrogênio em <b>formas que consiga absorver.</b>", "cards": ["N₂<br><p>atmosfera</p>", "🦠 Bactérias<br><p>fixação — ex.: <i>Rhizobium</i></p>", "NH₄⁺ / NO₃⁻<br><p>solo</p>", "🌱 Planta<br><p>absorve</p>", "🐄 Animal<br><p>alimentação</p>"], "bg": "https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=85&w=2400&auto=format&fit=crop"}, {"title": "Oxigênio: essencial para a vida", "lead": "O O₂ corresponde a cerca de <b>21% do ar.</b>", "cards": ["🫁 RESPIRAÇÃO CELULAR<p>glicose + O₂ → <b>energia</b></p>", "🔥 COMBUSTÃO<p>O₂ ajuda a manter a chama.</p>", "🕯️ → 🫙🕯️ → ♨<p>O oxigênio limitado é consumido e a chama apaga.</p>"], "bg": "https://images.unsplash.com/photo-1532938911079-1b06ac7ceec7?q=85&w=2400&auto=format&fit=crop"}, {"title": "CO₂: necessário ou prejudicial?", "lead": "O CO₂ tem <b>funções naturais</b>; o problema é alterar seu equilíbrio.", "cards": ["🌿 FOTOSSÍNTESE<p>CO₂ → matéria orgânica; O₂ é liberado.</p>", "☀ EFEITO ESTUFA NATURAL<p>Ajuda a manter a Terra habitável.</p>", "🏭 + 🌳<p>combustíveis fósseis + desmatamento</p>", "↑ CO₂ → 🌡<p>efeito estufa intensificado → aquecimento global</p>"], "bg": "https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?q=85&w=2400&auto=format&fit=crop"}, {"title": "A atmosfera muda naturalmente?", "lead": "A composição do ar é <b>dinâmica.</b>", "cards": ["🌋 Vulcões<p>CO₂, SO₂, H₂O</p>", "🔥 Incêndios naturais<p>CO₂, CO, CH₄</p>", "🌪 Poeira<p>partículas no ar</p>", "🌊 Oceanos<p>vapor d’água e troca de gases</p>", "🌿 Seres vivos<p>fotossíntese, respiração, transpiração</p>"], "bg": "https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?q=85&w=2400&auto=format&fit=crop"}, {"title": "Três maneiras de mudar o ar", "lead": "Fenômenos naturais também alteram a atmosfera.", "cards": ["🌋 VULCÕES<p>Liberam gases e partículas.</p>", "🔥 INCÊNDIOS NATURAIS<p>Transferem carbono da biomassa para o ar.</p>", "🌪 POEIRA<p>Ventos transportam partículas.</p>"], "bg": "https://images.unsplash.com/photo-1569240211563-7d047e7408b3?q=85&w=2400&auto=format&fit=crop"}, {"title": "A própria vida modifica a atmosfera", "lead": "Os organismos participam das <b>trocas de gases e água.</b>", "cards": ["🌿 FOTOSSÍNTESE<p>consome CO₂ e libera O₂</p>", "🫁 RESPIRAÇÃO<p>consome O₂ e libera CO₂</p>", "💧 TRANSPIRAÇÃO<p>libera vapor d’água</p>", "🌊 OCEANOS<p>evaporação, absorção de CO₂ e produção biológica de O₂</p>"], "bg": "https://images.unsplash.com/photo-1448375240586-882707db888b?q=85&w=2400&auto=format&fit=crop"}, {"title": "Quando nossas ações alteram o equilíbrio", "lead": "A influência humana pode modificar a composição atmosférica em grande escala.", "cards": ["1. CAUSAS<p>🏭 combustíveis fósseis<br>🌳 desmatamento<br>🚗 transporte e indústria</p>", "2. MUDANÇA NO AR<p>↑ gases de efeito estufa<br>↑ poluentes</p>", "3. CONSEQUÊNCIAS<p>🌡 aquecimento global<br>🌦 alterações climáticas<br>🌊 impactos nos oceanos</p>", "E O QUE PODEMOS FAZER?<p>reduzir emissões • conservar florestas • usar energia com maior eficiência</p>"], "bg": "https://images.unsplash.com/photo-1531058020387-3be344556be6?q=85&w=2400&auto=format&fit=crop"}];
const deck=document.getElementById('deck');
DATA.forEach((d,i)=>{
  const sec=document.createElement('section');
  sec.className='slide'+(i===0?' active':'');
  const cards=d.cards.map((x,j)=>`<div class="card reveal"><strong>${x}</strong></div>`).join('<div class="arrow reveal">→</div>');
  sec.innerHTML=`<div class="bg" style="background-image:url('${d.bg}')"></div><div class="shade"></div><header><span>MÓDULO 19 | CIÊNCIAS — 7º ANO</span><span>A NOSSA ATMOSFERA</span></header><h2>${d.title}</h2><p class="lead">${d.lead}</p><div class="content">${cards}</div>${i===0?'<div class="q reveal">Quais gases estamos respirando agora?</div>':''}`;
  deck.appendChild(sec);
});
